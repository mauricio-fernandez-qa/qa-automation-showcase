{
  "name": "qa-automation-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "E2E, API and performance test automation for a demo e-commerce, with an AI-assisted QA workflow (Claude Code).",
  "author": "Mauricio Fernandez",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "conventions": "node scripts/check-conventions.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run conventions",
    "perf": "k6 run --summary-export=results/k6-summary.json perf/products-load.js",
    "dashboard": "node scripts/dashboard/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.6",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.0",
    "zod": "^3.24.0"
  }
}
